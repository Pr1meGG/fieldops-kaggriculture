import math

def _shape(func, x):
    x = max(0.0, x)
    if func == 'linear': return x
    if func == 'sq':     return x * x
    if func == 'sqrt':   return math.sqrt(x)
    if func == 'log':    return math.log(1.0 + x)
    if func == 'log10':  return math.log10(1.0 + x)
    return x

PRICE_FLOOR = 1

def market_price(base, I0, T, below_func, below_target, above_func, above_target, inventory):
    if inventory < I0:
        f = below_func
        amp = below_target * base / _shape(f, T)
        price = base + amp * _shape(f, I0 - inventory)
    else:
        f = above_func
        amp = above_target * base / _shape(f, T)
        price = base - amp * _shape(f, inventory - I0)
    return max(PRICE_FLOOR, int(round(price)))

